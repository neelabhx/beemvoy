# SERPAPI_API_KEY: Server-side SerpApi credential for live flights/hotels/local search
SERPAPI_API_KEY="MY_SERPAPI_API_KEY"

# GEMINI_API_KEY: Required for natural-language intent parsing and trip synthesis
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FEATURE FLAGS & MOCK TOGGLE
USE_MOCK_DATA="true"

# SUPABASE AUTH & PERSISTENCE
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_USE_MOCK_DATA="true"
